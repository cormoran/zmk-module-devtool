# Nanopb options file for devtool.proto
# Every string/bytes field needs an explicit max_size (nanopb pitfall); every
# repeated field needs an explicit max_count.

cormoran.devtool.ErrorResponse.message   max_size:96

# Event tap: the RPC transport streams responses out with backpressure, so this
# max_count bounds per-response latency/RAM, not the TX buffer size.
cormoran.devtool.GetEventsResponse.events    max_count:6

# Log capture: source/message are formatted text truncated to fit. The RPC
# transport streams responses out with backpressure, so this max_count bounds
# per-response latency/RAM, not the TX buffer size.
cormoran.devtool.LogRecord.source            max_size:16
cormoran.devtool.LogRecord.message           max_size:48
cormoran.devtool.GetLogsResponse.records     max_count:3

# Streaming shares the same per-record sizing and the same latency/RAM (not
# TX-size) rationale for its batch cap.
cormoran.devtool.LogStreamNotification.records max_count:3

cormoran.devtool.SetLogCaptureFilterRequest.source max_size:16
